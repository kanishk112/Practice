                <mxCell id="32" value="&lt;h3 style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-path-to-node=&quot;1&quot;&gt;Functional Requirements (FR)&lt;/h3&gt;&lt;ol style=&quot;padding-inline-start: 32px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-path-to-node=&quot;2&quot; start=&quot;1&quot;&gt;&lt;li style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-path-to-node=&quot;2,0,0&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;0&quot; data-path-to-node=&quot;2,0,0&quot;&gt;Core Cache Operations:&lt;/b&gt; Support generic key-value storage with &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;62&quot; data-path-to-node=&quot;2,0,0&quot;&gt;get(K key)&lt;/code&gt;, &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;74&quot; data-path-to-node=&quot;2,0,0&quot;&gt;put(K key, V value)&lt;/code&gt;, &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;95&quot; data-path-to-node=&quot;2,0,0&quot;&gt;remove(K key)&lt;/code&gt;, &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;110&quot; data-path-to-node=&quot;2,0,0&quot;&gt;clear()&lt;/code&gt;, and &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;123&quot; data-path-to-node=&quot;2,0,0&quot;&gt;size()&lt;/code&gt; in &lt;span style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;133&quot; data-math=&quot;O(1)&quot; class=&quot;math-inline&quot;&gt;$O(1)$&lt;/span&gt; time complexity.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-path-to-node=&quot;2,1,0&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;0&quot; data-path-to-node=&quot;2,1,0&quot;&gt;Bounded Capacity &amp;amp; Eviction:&lt;/b&gt; The base in-memory cache must enforce a maximum capacity and evict the Least Recently Used (LRU) entry when full.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-path-to-node=&quot;2,2,0&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;0&quot; data-path-to-node=&quot;2,2,0&quot;&gt;Composable Metrics Tracking:&lt;/b&gt; Dynamically wrap any cache instance to record &lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;75&quot; data-path-to-node=&quot;2,2,0&quot;&gt;Hit Count&lt;/b&gt;, &lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;86&quot; data-path-to-node=&quot;2,2,0&quot;&gt;Miss Count&lt;/b&gt;, &lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;98&quot; data-path-to-node=&quot;2,2,0&quot;&gt;Put Count&lt;/b&gt;, &lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;109&quot; data-path-to-node=&quot;2,2,0&quot;&gt;Hit Ratio&lt;/b&gt;, and &lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;124&quot; data-path-to-node=&quot;2,2,0&quot;&gt;Operation Latency&lt;/b&gt; without modifying the core cache code.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-path-to-node=&quot;2,3,0&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;0&quot; data-path-to-node=&quot;2,3,0&quot;&gt;Composable Audit Logging:&lt;/b&gt; Dynamically wrap any cache instance to log cache accesses, mutations, and execution durations.&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-path-to-node=&quot;2,4,0&quot;&gt;&lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;0&quot; data-path-to-node=&quot;2,4,0&quot;&gt;Composable Thread-Safety:&lt;/b&gt; Allow single-threaded cache implementations to be dynamically upgraded to thread-safe caches via a concurrency wrapper.&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;div&gt;&lt;h2 style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-path-to-node=&quot;6&quot;&gt;Core Entities &amp;amp; Design Patterns&lt;/h2&gt;&lt;h3 style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-path-to-node=&quot;7&quot;&gt;Why the Decorator Pattern Instead of Inheritance?&lt;/h3&gt;&lt;p style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-path-to-node=&quot;8&quot;&gt;If we used standard inheritance to combine features (&lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;53&quot; data-path-to-node=&quot;8&quot;&gt;Logging&lt;/code&gt;, &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;62&quot; data-path-to-node=&quot;8&quot;&gt;Metrics&lt;/code&gt;, &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;71&quot; data-path-to-node=&quot;8&quot;&gt;ThreadSafety&lt;/code&gt;), we would hit a &lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;101&quot; data-path-to-node=&quot;8&quot;&gt;Combinatorial Class Explosion&lt;/b&gt; (&lt;span style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;132&quot; data-math=&quot;2^N&quot; class=&quot;math-inline&quot;&gt;$2^N$&lt;/span&gt; subclasses):&lt;/p&gt;&lt;ul style=&quot;padding-inline-start: 32px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-path-to-node=&quot;9&quot;&gt;&lt;li style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-path-to-node=&quot;9,0,0&quot;&gt;&lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,0,0&quot;&gt;LRUCache&lt;/code&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-path-to-node=&quot;9,1,0&quot;&gt;&lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,1,0&quot;&gt;LoggedLRUCache&lt;/code&gt;, &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;16&quot; data-path-to-node=&quot;9,1,0&quot;&gt;MetricsLRUCache&lt;/code&gt;, &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;33&quot; data-path-to-node=&quot;9,1,0&quot;&gt;SynchronizedLRUCache&lt;/code&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-path-to-node=&quot;9,2,0&quot;&gt;&lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;0&quot; data-path-to-node=&quot;9,2,0&quot;&gt;LoggedMetricsLRUCache&lt;/code&gt;, &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;23&quot; data-path-to-node=&quot;9,2,0&quot;&gt;SynchronizedLoggedMetricsLRUCache&lt;/code&gt;...&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-path-to-node=&quot;10&quot;&gt;And if we later introduced an &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;30&quot; data-path-to-node=&quot;10&quot;&gt;LFUCache&lt;/code&gt;, we would have to duplicate all those subclasses again.&lt;/p&gt;&lt;p style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-path-to-node=&quot;11&quot;&gt;The &lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;4&quot; data-path-to-node=&quot;11&quot;&gt;Decorator Pattern&lt;/b&gt; solves this by replacing inheritance with &lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;64&quot; data-path-to-node=&quot;11&quot;&gt;delegation&lt;/b&gt;:&lt;/p&gt;&lt;ul style=&quot;padding-inline-start: 32px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-path-to-node=&quot;12&quot;&gt;&lt;li style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-path-to-node=&quot;12,0,0&quot;&gt;Every decorator &lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;16&quot; data-path-to-node=&quot;12,0,0&quot;&gt;IS-A&lt;/b&gt; &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;21&quot; data-path-to-node=&quot;12,0,0&quot;&gt;Cache&amp;lt;K, V&amp;gt;&lt;/code&gt; (implements the interface so the client treats it identically to a raw cache).&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;p style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-path-to-node=&quot;12,1,0&quot;&gt;Every decorator &lt;b style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;16&quot; data-path-to-node=&quot;12,1,0&quot;&gt;HAS-A&lt;/b&gt; &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;22&quot; data-path-to-node=&quot;12,1,0&quot;&gt;Cache&amp;lt;K, V&amp;gt;&lt;/code&gt; (holds a &lt;code style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot; data-index-in-node=&quot;43&quot; data-path-to-node=&quot;12,1,0&quot;&gt;delegate&lt;/code&gt; reference to the next layer in the onion).&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
